{
  "name": "dsh-agent-scope",
  "version": "0.1.0",
  "private": true,
  "description": "Workspace-scoped named sub-agents for DeepSeek Harness: a Settings page that creates delegation targets at global scope or scoped to one workspace, mounted as official dsh-tool-subagent instances.",
  "type": "module",
  "license": "MIT",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
